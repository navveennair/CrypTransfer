@startuml CrypTransfer_Class_Diagram_Corrected
title CrypTransfer — Corrected Class Diagram (Mobile App Only)

skinparam classAttributeIconSize 0
skinparam linetype ortho

note as ScopeNote
  Scope: Flutter mobile client architecture only.
  CrypTransfer is a serverless mobile app — Cloud Firestore
  and Firebase Storage are accessed directly from the device
  via the Firebase SDK. There is NO separate backend server,
  custom database tier, or TLS channel class to model: TLS is
  provided transparently by the Firebase SDK over HTTPS.
  The Admin Dashboard is part of this same Flutter app
  (lib/presentation/admin/), not a separate web app.
end note

' ======================= ENUMS =======================
enum SessionState {
  open
  locked
  decrypting
  terminated
}

enum TransferStatus {
  pending
  received
  completed
  cleanup_initiated
  failed
  cancelled
}

enum NotificationType {
  rsaKeyReceived
  fileReceived
  connectionRequest
  transferCompleted
  unknown
}

' ======================= DOMAIN MODELS =======================
package "Domain Models (Firestore Documents)" {

  class User {
    + uid : String
    + username : String
    + email : String
    + phone : String
    + publicKey : String
    + isAdmin : bool
    + isActive : bool
    + isFirstTime : bool
    + isReadyToReceive : bool
    + selectedSenderUid : String
    + sessionActive : bool
    + createdAt : DateTime
    --
    + hasPublicKey() : bool
  }
  note right of User
    RSA **private key is NEVER stored here**.
    It exists only in FlutterSecureStorage
    on the owning device.
  end note

  class TransferSession {
    + transferId : String
    + senderId : String
    + receiverId : String
    + fileName : String
    + fileSize : int
    + encryptedAESKey : String
    + iv : String
    + encryptedFileUrl : String
    + status : TransferStatus
    + sessionActive : bool
    + senderCleanedUp : bool
    + receiverStatus : String
    + createdAt : DateTime
    + receivedAt : DateTime
  }
  note right of TransferSession
    encryptedAESKey = AES-256 session key,
    RSA-OAEP wrapped with receiver's public key.
    iv = 96-bit AES-GCM initialization vector.
    encryptedFileUrl = Firebase Storage download URL
    (NOT a local file path).
  end note

  class Handshake {
    + docId : String
    + senderId : String
    + receiverId : String
    + publicKey : String
    + status : String
    + receiverReady : bool
    + sentAt : DateTime
  }
  note right of Handshake
    Replaces "RSAKeys" entity.
    One doc = one RSA public-key handshake
    between a specific sender/receiver pair.
  end note

  class ConnectionProposal {
    + docId : String
    + proposerId : String
    + partnerId : String
    + status : String
    + createdAt : DateTime
    + updatedAt : DateTime
  }
  note right of ConnectionProposal
    Firestore "neutral_handshakes" collection.
    Deterministic ID: {proposerId}_{partnerId}.
    Symmetric friend-connection request/accept.
  end note

  class NotificationModel {
    + id : String
    + toUserId : String
    + fromUsername : String
    + message : String
    + type : NotificationType
    + transferId : String
    + read : bool
    + createdAt : DateTime
  }
}

' ======================= REPOSITORIES =======================
package "Repositories (Data Access Layer)" {

  class AuthRepository {
    + currentUser : User
    --
    + register(username, email, phone, password) : UserCredential
    + loginWithUsername(username, password) : UserCredential
    + signInWithGoogle() : UserCredential
    + logout() : void
    + generateAndStoreKeyPair() : void
    + regenerateKeyPair(uid) : void
    + deleteKeyPair(uid) : void
    + getUserProfile(uid) : User
    + computeFingerprint(publicKeyJson) : String
  }

  class KeyRepository {
    + searchUsers(query) : List<User>
    + sendConnectionRequest(targetUserId) : void
    + disconnectFriend(friendId) : void
    + sendPublicKey(toUserId, toUsername, isHandshake) : void
    + selectSenderHandshake(senderUid, senderUsername) : String
    + streamHandshakesForSender() : Stream<Handshake>
    + setReadyToReceive(ready) : void
    + endSessionCleanup(transferId, handshakeId, receiverId) : void
    + wipeAllSessionKeys(uid) : void
  }

  class HandshakeRepository {
    + sendProposal(partnerUid, partnerUsername) : void
    + acceptProposal(docId, proposerId) : void
    + rejectProposal(docId) : void
    + cancelProposal(docId) : void
    + disconnectFromUser(partnerUid) : void
    + streamIncomingPending() : Stream<ConnectionProposal>
    + streamHandshakeWithUser(partnerUid) : Stream
  }

  class TransferRepository {
    + generateId() : String
    + uploadAndCreate(transferId, encryptedBytes, fileName, ...) : Stream<double>
    + getTransfer(transferId) : TransferSession
    + downloadEncryptedFile(transferId) : Uint8List
    + markReceived(transferId) : void
    + updateReceiverStatus(transferId, status) : void
    + initiateCleanup(transferId) : void
    + senderWipeAESKey(transferId) : void
    + writeFinalAuditLog(senderId, receiverId, ...) : void
    + watchTransferStatus(transferId) : Stream<TransferSession>
  }

  class CleanupRepository {
    + initiateReceiverCleanup(transferId, receiverId, senderId, ...) : void
    + completeReceiverCleanup(transferId, receiverId, senderId, ...) : void
    + watchTransferForDeletion(transferId) : Stream
  }
}

' ======================= CORE SERVICES =======================
package "Core Services" {

  class EncryptionService <<static>> {
    + encryptAesGcm(plaintext) : AesEncryptResult
    + decryptAesGcm(ciphertext, key, iv) : Uint8List
    + generateRsaKeyPairSync() : AsymmetricKeyPair
    + rsaEncrypt(publicKey, data) : Uint8List
    + rsaDecrypt(privateKey, ciphertext) : Uint8List
    + encodePublicKey(key) : String
    + encodePrivateKey(key) : String
    + setupReceiverSession(uid) : void
    + closeReceiverSession(uid) : void
    + bindSession(stateStream, uid) : void
    + unbindSession() : void
  }
  note bottom of EncryptionService
    Stateless utility — keys are passed as
    parameters/return values, never held as
    instance fields. AES-GCM ops run inside
    compute() isolates.
  end note

  class SessionManager {
    + state : SessionState
    + activeSenderUid : String
    + activeSenderUsername : String
    + stateStream : Stream<SessionState>
    --
    + selectSender(uid, username) : void
    + clearSender() : void
    + lock() : void
    + setDecrypting() : void
    + reset() : void
    + wipeSession(onBuffersWipe) : void
    + handleLifecycleState(lifecycle, onBuffersWipe) : void
  }
  note bottom of SessionManager
    "Closed Mailbox" kill-switch state machine.
    One instance per ReceiverScreen session.
  end note

  class SecurityLifecycleMixin <<mixin>> {
    + registerBuffer(buffer) : void
    + unregisterBuffer(buffer) : void
    + wipeAll() : void
    + isFlagSecureActive() : bool
    + {static} requestNativeClear() : void
  }
  note bottom of SecurityLifecycleMixin
    Applied to SenderScreen, ReceiverScreen,
    DecryptScreen, TransferProgressScreen, etc.
    Zero-wipes Uint8List plaintext/key buffers.
  end note

  class TransferService <<static>> {
    + kChunkSize : int = 65536
    + readFile(filePath) : Uint8List
    + readChunked(filePath) : Stream<Uint8List>
    + resolve(filePath, fallbackBytes) : Uint8List
  }
  note bottom of TransferService
    64 KB chunked file I/O for memory-stable
    handling of large files before AES-GCM
    encryption.
  end note
}

' ======================= RELATIONSHIPS =======================

AuthRepository "1" --> "0..*" User : creates / reads
AuthRepository ..> EncryptionService : generates RSA keypair

KeyRepository --> User : queries / updates
KeyRepository "1" --> "0..*" Handshake : creates / streams

HandshakeRepository "1" --> "0..*" ConnectionProposal : creates / accepts / rejects

TransferRepository "1" --> "0..*" TransferSession : creates / updates / deletes
TransferRepository ..> NotificationModel : creates

CleanupRepository --> TransferSession : updates status / deletes

User "1" -- "0..*" TransferSession : senderId / receiverId
User "1" -- "0..*" Handshake : senderId / receiverId
User "1" -- "0..*" ConnectionProposal : proposerId / partnerId
User "1" -- "0..*" NotificationModel : toUserId

SessionManager ..> EncryptionService : stateStream\n(bindSession ->\ncloseReceiverSession)
EncryptionService ..> SecurityLifecycleMixin : requestNativeClear()

TransferSession --> TransferStatus
NotificationModel --> NotificationType
SessionManager --> SessionState

@enduml
