rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admin helper ────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // List is public so username lookup works before auth (login/register).
    // Individual document GET requires authentication.
    match /users/{userId} {
      allow list: if true;
      allow get: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ── users/{userId}/notifications ──────────────────────────────────────
      // Owner reads/updates/deletes their own notifications.
      // Any authenticated user may create (sender writes to receiver's path).
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated() &&
                         request.resource.data.toUserId == userId;
      }

      // ── users/{userId}/friend_requests ────────────────────────────────────
      // Stored under the RECEIVER's path (userId == receiver).
      // Sender writes to receiver's subcollection and can read back their own
      // sent requests (senderId == auth.uid).  Receiver owns the subcollection.
      match /friend_requests/{reqId} {
        allow read:   if isOwner(userId) ||
                         (isAuthenticated() &&
                          resource.data.senderId == request.auth.uid);
        // Any authenticated user may create a request in another user's
        // subcollection, provided the senderId field is their own UID.
        allow create: if isAuthenticated() &&
                         request.resource.data.senderId == request.auth.uid;
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // ── users/{userId}/connections ─────────────────────────────────────────
      // A user can read their own connections.
      // Other authenticated users can read to verify connection status.
      // Owner/Admin can write.  The accepting party can also create the
      // bilateral entry — verified by the existence of a pending friend request
      // from themselves in the target user's subcollection.
      match /connections/{connId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) ||
                         isAdmin() ||
                         (isAuthenticated() &&
                          request.resource.data.uid == request.auth.uid &&
                          exists(/databases/$(database)/documents/users/$(request.auth.uid)/friend_requests/$(userId)));
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // ── users/{userId}/audit_logs ──────────────────────────────────────────
      // Immutable personal transfer history. Each user owns their own copy.
      // EndSessionScreen writes one record here for the sender AND one for
      // the receiver in a single batch — so create is allowed for any
      // authenticated user who is named as sender or receiver in the document.
      // UPDATE is permanently false — these records are append-only evidence.
      match /audit_logs/{logId} {
        // Owner reads their own history; admin sees all.
        allow read: if isOwner(userId) || isAdmin();

        // A participant (sender or receiver) may create a log in any
        // user's sub-collection, provided they appear in the document.
        allow create: if isAuthenticated() &&
                         (request.resource.data.senderId == request.auth.uid ||
                          request.resource.data.receiverId == request.auth.uid);

        allow update: if false;       // IMMUTABLE — never modifiable by anyone
        allow delete: if isAdmin();   // Admin-only emergency purge
      }

      // ── users/{userId}/rsa_key_manager ───────────────────────────────────────
      // Append-only RSA key lifecycle audit log. Owner creates; admin deletes.
      // Documents are IMMUTABLE (update: false) — tamper-evident evidence trail.
      match /rsa_key_manager/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                         request.resource.data.action in ['generated', 'regenerated', 'deleted'];
        allow update: if false;       // IMMUTABLE
        allow delete: if isAdmin();
      }

      // ── users/{userId}/profile ────────────────────────────────────────────────
      // Security/UX preferences. Owner reads/creates/updates; admin can manage.
      match /profile/{prefId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // ── users/{userId}/friendships ────────────────────────────────────────
      // Owner can read/write their own list.
      // Any authenticated user may CREATE an entry in another user's list
      // only if the document's uid field equals their own uid (adding self).
      match /friendships/{friendId} {
        allow read: if request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
        allow create: if isAuthenticated() &&
                         request.resource.data.uid == request.auth.uid;
      }
    }

    // Collection-group rule so senders can query their sent requests
    // across all receivers' subcollections via collectionGroup().
    match /{path=**}/friend_requests/{reqId} {
      allow read: if isAuthenticated() &&
                     (resource.data.senderId == request.auth.uid ||
                      resource.data.receiverId == request.auth.uid);
    }

    // Collection-group rule so any authenticated user can query connections
    // across subcollections (needed for getConnectionStatus cross-user lookups).
    match /{path=**}/connections/{connId} {
      allow read: if isAuthenticated();
    }

    // ─── transfers ──────────────────────────────────────────────────────────
    // Only the sender or receiver of a transfer may read/write it.
    // RULE: Create allowed if receiver has explicitly authorized this sender
    //       (selectedSenderUid == auth.uid) OR both users share a connection.
    match /transfers/{transferId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);

      allow create: if isAuthenticated() &&
                       request.resource.data.senderId == request.auth.uid &&
                       (
                         // Handshake-authorized: receiver explicitly selected this sender
                         get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data['selectedSenderUid'] == request.auth.uid
                         // Connection-based fallback for pre-established social connections
                         || (exists(/databases/$(database)/documents/users/$(request.resource.data.senderId)/connections/$(request.resource.data.receiverId)) &&
                             exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId)/connections/$(request.resource.data.senderId)))
                       );
      
      allow update: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);
      
      allow delete: if isAuthenticated() &&
                       resource.data.senderId == request.auth.uid;
    }

    // ─── handshakes ──────────────────────────────────────────────────────────
    // Receiver creates the document (publishes their RSA public key).
    // Both sender and receiver can read and update (sender may ack).
    // Either party can delete during session cleanup.
    match /handshakes/{handshakeId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid ||
                        isAdmin());
      
      // Receiver creates the handshake document (receiverId == auth.uid)
      allow create: if isAuthenticated() &&
                       request.resource.data.receiverId == request.auth.uid;
      
      // Either participant may update (receiver publishes key; sender may ack)
      allow update: if isAuthenticated() &&
                       (resource.data.receiverId == request.auth.uid ||
                        resource.data.senderId == request.auth.uid);
      
      // Sender may delete during zero-remanence cleanup
      allow delete: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid || isAdmin());
    }


    // ─── transfer_logs ───────────────────────────────────────────────────────
    // Append-only per-transfer start log. Participants may read; admin sees all.
    match /transfer_logs/{logId} {
      allow read:   if isAuthenticated() &&
                       (request.auth.uid in resource.data.get('participants', []) || isAdmin());
      allow create: if isAuthenticated() &&
                       (request.auth.uid in request.resource.data.get('participants', []) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── security_audit_log ──────────────────────────────────────────────────
    // Append-only; readable only by admins.
    match /security_audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

  }
}
