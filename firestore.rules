rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admin helper ────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // List is public so username lookup works before auth (login/register).
    // Individual document GET requires authentication.
    match /users/{userId} {
      allow list: if true;  // Required for username availability check during registration
      allow get: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ── users/{userId}/notifications ──────────────────────────────────────
      // Owner reads/updates/deletes their own notifications.
      // Any authenticated user may create (sender writes to receiver's path).
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated() &&
                         request.resource.data.toUserId == userId;
      }

      // ── users/{userId}/audit_logs ──────────────────────────────────────────
      // Immutable personal transfer history. Each user owns their own copy.
      // EndSessionScreen writes one record here for the sender AND one for
      // the receiver in a single batch — so create is allowed for any
      // authenticated user who is named as sender or receiver in the document.
      // UPDATE is permanently false — these records are append-only evidence.
      match /audit_logs/{logId} {
        // Owner reads their own history; admin sees all.
        allow read: if isOwner(userId) || isAdmin();

        // A participant (sender or receiver) may create a log in any
        // user's sub-collection, provided they appear in the document.
        allow create: if isAuthenticated() &&
                         (request.resource.data.senderId == request.auth.uid ||
                          request.resource.data.receiverId == request.auth.uid);

        allow update: if false;       // IMMUTABLE — never modifiable by anyone
        allow delete: if isAdmin();   // Admin-only emergency purge
      }

      // ── users/{userId}/rsa_key_manager ───────────────────────────────────────
      // Append-only RSA key lifecycle audit log. Owner creates; admin deletes.
      // Documents are IMMUTABLE (update: false) — tamper-evident evidence trail.
      match /rsa_key_manager/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
                         request.resource.data.action in ['generated', 'regenerated', 'deleted'];
        allow update: if false;       // IMMUTABLE
        allow delete: if isAdmin();
      }

      // ── users/{userId}/profile ────────────────────────────────────────────────
      // Security/UX preferences. Owner reads/creates/updates; admin can manage.
      match /profile/{prefId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // ── users/{userId}/friendships ────────────────────────────────────────
      // Owner can read/write their own list.
      // During accept flow, the accepting user (friendId) may create/update the proposer's
      // friendship doc to establish bidirectional 'accepted' status.
      // Also allow friendId to delete their own mirror entry (needed for bilateral WriteBatch
      // disconnect — user A deletes users/B/friendships/A where friendId == A).
      match /friendships/{friendId} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow write: if request.auth.uid == userId ||
                       (request.auth.uid == friendId &&
                        request.resource.data.status == 'accepted');
        allow delete: if request.auth.uid == friendId;
      }
    }

    // ─── transfers ──────────────────────────────────────────────────────────
    // Only the sender or receiver of a transfer may read/write it.
    // RULE: Create allowed if receiver has explicitly authorized this sender
    //       (selectedSenderUid == auth.uid) OR a neutral_handshake exists.
    match /transfers/{transferId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);

      allow create: if isAuthenticated() &&
                       request.resource.data.senderId == request.auth.uid &&
                       (
                         // Handshake-authorized: receiver explicitly selected this sender
                         get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data['selectedSenderUid'] == request.auth.uid
                         // Neutral handshake: either party may have proposed
                         || exists(/databases/$(database)/documents/neutral_handshakes/$(request.auth.uid + '_' + request.resource.data.receiverId))
                         || exists(/databases/$(database)/documents/neutral_handshakes/$(request.resource.data.receiverId + '_' + request.auth.uid))
                       );

      allow update: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);

      // Receiver triggers cleanup (endSessionCleanup WriteBatch) — must be able to delete.
      allow delete: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);
    }

    // ─── handshakes ──────────────────────────────────────────────────────────
    // Receiver creates the document (publishes their RSA public key).
    // Both sender and receiver can read and update (sender may ack).
    // Either party can delete during session cleanup.
    match /handshakes/{handshakeId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid ||
                        isAdmin());

      // Only receiver may create (via selectSenderHandshake atomic WriteBatch).
      // Sender NEVER creates handshake docs; all session handshakes initiated by receiver.
      allow create: if isAuthenticated() &&
                       request.resource.data.receiverId == request.auth.uid;

      // Either participant may update (receiver publishes key; sender may ack)
      allow update: if isAuthenticated() &&
                       (resource.data.receiverId == request.auth.uid ||
                        resource.data.senderId == request.auth.uid);

      // Either participant may delete during zero-remanence cleanup
      allow delete: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid ||
                        isAdmin());
    }

    // ─── neutral_handshakes ──────────────────────────────────────────────────
    // Connection-layer neutral handshakes. Separate from session-layer `handshakes`.
    // proposer creates; both parties read; only partner may accept/reject;
    // proposer's own doc may also be marked connected (mutual-accept WriteBatch);
    // either party may delete (cancel or post-session cleanup).
    match /neutral_handshakes/{handshakeId} {
      // resource == null when doc doesn't exist; needed for runTransaction tx.get()
      // on a not-yet-created doc (WR-01 idempotent sendProposal).
      allow read: if isAuthenticated() &&
                     (resource == null ||
                      resource.data.proposerId == request.auth.uid ||
                      resource.data.partnerId == request.auth.uid);

      // Only proposer may create, and only with their own UID as proposerId
      // WR-05: self-proposals blocked — proposerId must differ from partnerId
      allow create: if isAuthenticated() &&
                       request.resource.data.proposerId == request.auth.uid &&
                       request.resource.data.proposerId != request.resource.data.partnerId;

      // Partner may accept or reject; proposer's own doc may be marked connected
      // by a mutual-accept WriteBatch (proposer cannot reject their own proposal)
      // WR-06: update restricted to status+updatedAt fields only
      // WR-01: proposer may resend (idempotent) — status back to 'pending' allowed for usernames refresh
      allow update: if isAuthenticated() && (
        (resource.data.partnerId == request.auth.uid &&
         request.resource.data.status in ['connected', 'rejected'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        ||
        (resource.data.proposerId == request.auth.uid &&
         (request.resource.data.status == 'connected' ||
          request.resource.data.status == 'pending') &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'proposerUsername', 'partnerUsername']))
      );

      // Either party may delete (cancel proposal or post-session cleanup).
      // resource == null guard: batch.delete() on a non-existent mirror doc
      // (e.g. B_A when only A_B exists) is evaluated with resource=null,
      // making field comparisons return false → PERMISSION_DENIED without this guard.
      allow delete: if isAuthenticated() &&
                       (resource == null ||
                        resource.data.proposerId == request.auth.uid ||
                        resource.data.partnerId == request.auth.uid);
    }

    // ─── transfer_logs ───────────────────────────────────────────────────────
    // Append-only per-transfer start log. Participants may read; admin sees all.
    match /transfer_logs/{logId} {
      allow read:   if isAuthenticated() &&
                       (request.auth.uid in resource.data.get('participants', []) || isAdmin());
      allow create: if isAuthenticated() &&
                       (request.auth.uid in request.resource.data.get('participants', []) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── security_audit_log ──────────────────────────────────────────────────
    // Append-only; readable only by admins.
    match /security_audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

  }
}
