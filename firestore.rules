rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admin helper ────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // Public read for user search; only owner or admin can write.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ── users/{userId}/notifications ──────────────────────────────────────
      // Owner reads/updates/deletes their own notifications.
      // Any authenticated user may create (sender writes to receiver's path).
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated() &&
                         request.resource.data.toUserId == userId;
      }

      // ── users/{userId}/friend_requests ────────────────────────────────────
      // Stored under the sender's path. The receiver can also read via
      // collectionGroup query (see below).
      match /friend_requests/{reqId} {
        allow read:   if isOwner(userId) ||
                         (isAuthenticated() &&
                          resource.data.receiverId == request.auth.uid);
        allow create: if isOwner(userId) &&
                         request.resource.data.senderId == userId;
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // ── users/{userId}/connections ─────────────────────────────────────────
      // A user can read their own connections.
      // Other authenticated users can read to verify connection status.
      // Owner and Admin can write.
      match /connections/{connId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Collection-group rule so receivers can query friend_requests across all senders.
    match /{path=**}/friend_requests/{reqId} {
      allow read: if isAuthenticated() &&
                     (resource.data.senderId == request.auth.uid ||
                      resource.data.receiverId == request.auth.uid);
    }

    // ─── transfers ──────────────────────────────────────────────────────────
    // Only the sender or receiver of a transfer may read/write it.
    // RULE: Transfers only allowed if both users are in each other's connections.
    match /transfers/{transferId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);
      
      allow create: if isAuthenticated() &&
                       request.resource.data.senderId == request.auth.uid &&
                       exists(/databases/$(database)/documents/users/$(request.resource.data.senderId)/connections/$(request.resource.data.receiverId)) &&
                       exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId)/connections/$(request.resource.data.senderId));
      
      allow update: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);
      
      allow delete: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid);
    }

    // ─── handshakes ──────────────────────────────────────────────────────────
    // Formerly rsa_key_transfers. Renamed fields to senderId/receiverId.
    match /handshakes/{handshakeId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid ||
                        isAdmin());
      
      allow create: if isAuthenticated() &&
                       request.resource.data.receiverId == request.auth.uid;
      
      allow update: if isAuthenticated() &&
                       resource.data.receiverId == request.auth.uid;
      
      allow delete: if isAuthenticated() &&
                       (resource.data.senderId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid) ||
                    isAdmin();
    }

    // ─── transfer_logs ───────────────────────────────────────────────────────
    // Append-only audit log. Participants may read their own entries; admin sees all.
    match /transfer_logs/{logId} {
      allow read:   if isAuthenticated() &&
                       (request.auth.uid in resource.data.get('participants', []) || isAdmin());
      allow create: if isAuthenticated() &&
                       (request.auth.uid in request.resource.data.get('participants', []) || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── security_audit_log ──────────────────────────────────────────────────
    // Append-only; readable only by admins.
    match /security_audit_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
