      "isDeleted": false,
      "boundElements": null,
      "updated": 1782145952822,
      "link": null,
      "locked": false,
      "text": "Note: Gate is integrated into SenderController.encryptAesKey(); falls back to device PIN/password when no biometric hardware exists.",
