      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Note: Gate is integrated into SenderController.encryptAesKey(); falls back to device PIN/password when no biometric hardware exists.",
