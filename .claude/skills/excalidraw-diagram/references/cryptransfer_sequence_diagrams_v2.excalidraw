    {
      "id": "sd0000463",
      "type": "text",
      "x": 0,
      "y": -56,
      "width": 2635.36,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 721832696,
      "version": 1,
      "versionNonce": 1436395164,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782145952822,
      "link": null,
      "locked": false,
      "text": "Updated from the original Python/Kivy/SQL Server thesis design (SD001-SD015) to match the real Flutter + Firebase implementation: no central SystemController, repositories call FirebaseAuth/Firestore/Storage directly, crypto runs in compute() isolates, and the RSA exchange is a two-layer Firestore handshake (neutral_handshakes + handshakes), not a single step.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Updated from the original Python/Kivy/SQL Server thesis design (SD001-SD015) to match the real Flutter + Firebase implementation: no central SystemController, repositories call FirebaseAuth/Firestore/Storage directly, crypto runs in compute() isolates, and the RSA exchange is a two-layer Firestore handshake (neutral_handshakes + handshakes), not a single step.",
      "lineHeight": 1.25
    },
