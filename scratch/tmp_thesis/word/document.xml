80"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>Field</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>Type / Reference</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>Notes</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>keyVaultCreatedAt</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>timestamp</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>Stamped on RSA key (re)generation</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>lastVaultAccessAt</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>timestamp</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="2880"/></w:tcPr><w:p><w:r><w:t>Stamped each time the user opens their key vault</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Removed dead "connections" Firestore-collection constant - the schema never wrote to users/{uid}/connections; the actual accepted-friend subcollection is users/{uid}/friendships/{otherUid} (written by sendConnectionRequest / acceptProposal). The "Connection" entity above has been corrected to this real path. Also documented three additional supporting collections present in the codebase but missing from this ERD: SecurityAuditLog, RsaKeyManagerLog, and UserPreferences.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Key Corrections vs. Previous (Relational) ERD</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Removed "password" from User - Firebase Auth manages credentials; never stored in Firestore.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Replaced "role" with "isAdmin" (bool) - matches actual privilege model used by the Admin Dashboard.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Removed standalone "RSAKeys" table (keyID/publicKeyID/privateKeyID). Public key is an inline string field on User and on Handshake. Private key is device-only (FlutterSecureStorage) and is intentionally absent from any database schema - this is a security boundary, not an omission.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Removed standalone "AESKey" / "AESKey (Ref Shared Object)" tables - the encrypted AES session key ("encryptedAESKey") is a field embedded directly in the Transfer document. There is no shared AES key object referenced by multiple entities.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Added "iv" (AES initialization vector) field to Transfer - required for decryption, missing entirely from the original diagram.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Removed standalone "File" table - fileName, fileSize and encryptedFileUrl (replaces filePath) are embedded directly in the Transfer document. fileType is not tracked.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Renamed "TransferSession" to "Transfer" and expanded it with the real lifecycle/status fields used by the synchronized cleanup protocol (status, sessionActive, senderCleanedUp, receiverStatus, cleanupInitiatedAt, etc.).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Added four entity types missing from the original ERD entirely: Handshake (RSA exchange), NeutralHandshake (connection proposals), Connection (accepted friendships), AuditLog (immutable history), and Notification (inbox).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Corrected Admin Dashboard data source - previously the "Total Transfers" stat and "Transfer Log" feed read a top-level transfer_logs collection that was populated only by an unused dead-code path (TransferLogService.logTransferStart / TransferRepository.writeAuditLog, both removed). Both now read the audit_logs collection group, the same data HomeScreen already used, so admin metrics reflect real activity.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>Corrected cardinality - all relationships are 1:N (one User has many Transfers, Handshakes, Connections, AuditLogs), not the 1:1 chains shown in the original diagram.</w:t></w:r></w:p><w:sectPr w:rsidR="00FC693F" w:rsidRPr="0006063C" w:rsidSect="00034616"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1800" w:bottom="1440" w:left="1800" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>