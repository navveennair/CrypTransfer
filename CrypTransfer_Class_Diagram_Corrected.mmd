%% CrypTransfer — Corrected Class Diagram (Mobile App Only)
%% Scope: Flutter mobile client architecture only.
%% CrypTransfer is a serverless mobile app — Cloud Firestore and Firebase
%% Storage are accessed directly from the device via the Firebase SDK.
%% There is NO separate backend server, custom database tier, or TLS
%% channel class to model: TLS is provided transparently by the Firebase
%% SDK over HTTPS. The Admin Dashboard is part of this same Flutter app
%% (lib/presentation/admin/), not a separate web app.

classDiagram

%% ======================= ENUMS =======================
class SessionState {
  <<enumeration>>
  open
  locked
  decrypting
  terminated
}

class TransferStatus {
  <<enumeration>>
  pending
  received
  completed
  cleanup_initiated
  failed
  cancelled
}

class NotificationType {
  <<enumeration>>
  rsaKeyReceived
  fileReceived
  connectionRequest
  transferCompleted
  unknown
}

%% ======================= DOMAIN MODELS =======================
class User {
  +String uid
  +String username
  +String email
  +String phone
  +String publicKey
  +bool isAdmin
  +bool isActive
  +bool isFirstTime
  +bool isReadyToReceive
  +String selectedSenderUid
  +bool sessionActive
  +DateTime createdAt
  +hasPublicKey() bool
}
note for User "RSA private key is NEVER stored here.\nIt exists only in FlutterSecureStorage\non the owning device."

class TransferSession {
  +String transferId
  +String senderId
  +String receiverId
  +String fileName
  +int fileSize
  +String encryptedAESKey
  +String iv
  +String encryptedFileUrl
  +TransferStatus status
  +bool sessionActive
  +bool senderCleanedUp
  +String receiverStatus
  +DateTime createdAt
  +DateTime receivedAt
}
note for TransferSession "encryptedAESKey = AES-256 session key,\nRSA-OAEP wrapped with receiver's public key.\niv = 96-bit AES-GCM initialization vector.\nencryptedFileUrl = Firebase Storage download URL\n(NOT a local file path)."

class Handshake {
  +String docId
  +String senderId
  +String receiverId
  +String publicKey
  +String status
  +bool receiverReady
  +DateTime sentAt
}
note for Handshake "Replaces 'RSAKeys' entity.\nOne doc = one RSA public-key handshake\nbetween a specific sender/receiver pair."

class ConnectionProposal {
  +String docId
  +String proposerId
  +String partnerId
  +String status
  +DateTime createdAt
  +DateTime updatedAt
}
note for ConnectionProposal "Firestore 'neutral_handshakes' collection.\nDeterministic ID: proposerId_partnerId.\nSymmetric friend-connection request/accept."

class NotificationModel {
  +String id
  +String toUserId
  +String fromUsername
  +String message
  +NotificationType type
  +String transferId
  +bool read
  +DateTime createdAt
}

%% ======================= REPOSITORIES =======================
class AuthRepository {
  +User currentUser
  +register(username, email, phone, password) UserCredential
  +loginWithUsername(username, password) UserCredential
  +signInWithGoogle() UserCredential
  +logout() void
  +generateAndStoreKeyPair() void
  +regenerateKeyPair(uid) void
  +deleteKeyPair(uid) void
  +getUserProfile(uid) User
  +computeFingerprint(publicKeyJson) String
}

class KeyRepository {
  +searchUsers(query) List~User~
  +sendConnectionRequest(targetUserId) void
  +disconnectFriend(friendId) void
  +sendPublicKey(toUserId, toUsername, isHandshake) void
  +selectSenderHandshake(senderUid, senderUsername) String
  +streamHandshakesForSender() Stream~Handshake~
  +setReadyToReceive(ready) void
  +endSessionCleanup(transferId, handshakeId, receiverId) void
  +wipeAllSessionKeys(uid) void
}

class HandshakeRepository {
  +sendProposal(partnerUid, partnerUsername) void
  +acceptProposal(docId, proposerId) void
  +rejectProposal(docId) void
  +cancelProposal(docId) void
  +disconnectFromUser(partnerUid) void
  +streamIncomingPending() Stream~ConnectionProposal~
  +streamHandshakeWithUser(partnerUid) Stream
}

class TransferRepository {
  +generateId() String
  +uploadAndCreate(transferId, encryptedBytes, fileName) Stream~double~
  +getTransfer(transferId) TransferSession
  +downloadEncryptedFile(transferId) Uint8List
  +markReceived(transferId) void
  +updateReceiverStatus(transferId, status) void
  +initiateCleanup(transferId) void
  +senderWipeAESKey(transferId) void
  +writeFinalAuditLog(senderId, receiverId) void
  +watchTransferStatus(transferId) Stream~TransferSession~
}

class CleanupRepository {
  +initiateReceiverCleanup(transferId, receiverId, senderId) void
  +completeReceiverCleanup(transferId, receiverId, senderId) void
  +watchTransferForDeletion(transferId) Stream
}

%% ======================= CORE SERVICES =======================
class EncryptionService {
  <<static>>
  +encryptAesGcm(plaintext) AesEncryptResult
  +decryptAesGcm(ciphertext, key, iv) Uint8List
  +generateRsaKeyPairSync() AsymmetricKeyPair
  +rsaEncrypt(publicKey, data) Uint8List
  +rsaDecrypt(privateKey, ciphertext) Uint8List
  +encodePublicKey(key) String
  +encodePrivateKey(key) String
  +setupReceiverSession(uid) void
  +closeReceiverSession(uid) void
  +bindSession(stateStream, uid) void
  +unbindSession() void
}
note for EncryptionService "Stateless utility — keys are passed as\nparameters/return values, never held as\ninstance fields. AES-GCM ops run inside\ncompute() isolates."

class SessionManager {
  +SessionState state
  +String activeSenderUid
  +String activeSenderUsername
  +Stream~SessionState~ stateStream
  +selectSender(uid, username) void
  +clearSender() void
  +lock() void
  +setDecrypting() void
  +reset() void
  +wipeSession(onBuffersWipe) void
  +handleLifecycleState(lifecycle, onBuffersWipe) void
}
note for SessionManager "'Closed Mailbox' kill-switch state machine.\nOne instance per ReceiverScreen session."

class SecurityLifecycleMixin {
  <<mixin>>
  +registerBuffer(buffer) void
  +unregisterBuffer(buffer) void
  +wipeAll() void
  +isFlagSecureActive() bool
  +requestNativeClear()$ void
}
note for SecurityLifecycleMixin "Applied to SenderScreen, ReceiverScreen,\nDecryptScreen, TransferProgressScreen, etc.\nZero-wipes Uint8List plaintext/key buffers."

class TransferService {
  <<static>>
  +int kChunkSize = 65536
  +readFile(filePath) Uint8List
  +readChunked(filePath) Stream~Uint8List~
  +resolve(filePath, fallbackBytes) Uint8List
}
note for TransferService "64 KB chunked file I/O for memory-stable\nhandling of large files before AES-GCM\nencryption."

%% ======================= RELATIONSHIPS =======================

AuthRepository "1" --> "0..*" User : creates / reads
AuthRepository ..> EncryptionService : generates RSA keypair

KeyRepository --> User : queries / updates
KeyRepository "1" --> "0..*" Handshake : creates / streams

HandshakeRepository "1" --> "0..*" ConnectionProposal : creates / accepts / rejects

TransferRepository "1" --> "0..*" TransferSession : creates / updates / deletes
TransferRepository ..> NotificationModel : creates

CleanupRepository --> TransferSession : updates status / deletes

User "1" -- "0..*" TransferSession : senderId / receiverId
User "1" -- "0..*" Handshake : senderId / receiverId
User "1" -- "0..*" ConnectionProposal : proposerId / partnerId
User "1" -- "0..*" NotificationModel : toUserId

SessionManager ..> EncryptionService : stateStream bindSession -> closeReceiverSession
EncryptionService ..> SecurityLifecycleMixin : requestNativeClear()

TransferSession --> TransferStatus
NotificationModel --> NotificationType
SessionManager --> SessionState
